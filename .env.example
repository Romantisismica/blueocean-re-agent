# Scout / Bot (backend). Copia a `.env` o configúralas como variables de entorno.
BRAVE_SEARCH_API_KEY=<TU_BRAVE_KEY>
TELEGRAM_BOT_TOKEN=<TU_BOT_TOKEN>

# Supabase (Project Settings > API)
SUPABASE_URL=https://<TU-PROYECTO>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<TU_SERVICE_ROLE_KEY>   # solo backend, nunca en el front

# OpenCode Go (lenguaje natural del bot)
LLM_API_URL=https://opencode.ai/zen/go/v1/chat/completions
LLM_API_KEY=<TU_OPENCODE_GO_KEY>
LLM_MODEL=deepseek-v4-flash
